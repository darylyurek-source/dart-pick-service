# Required
DATABASE_URL=postgres://user:password@host:5432/dart_pick   # a NEW database, not DART's
SERVICE_API_KEY=            # a long random string you invent; Base44 sends it as x-api-key
MASSIVE_API_KEY=            # from massive.com/dashboard (Keys)

# Optional (defaults shown)
# WAIT_SECONDS=300          # the wait between the two snapshots
# GATE_THRESHOLD_PCT=0.5    # required move in the stock's own direction
# MAX_TRADE_AGE_SEC=120     # skip a stock whose last trade is older than this
# MAX_IN_FLIGHT=5           # requests allowed to run at once
# PORT=8080
